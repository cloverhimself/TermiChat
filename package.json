{
  "name": "termichat",
  "version": "0.4.0",
  "description": "Terminal chat over TCP",
  "scripts": {
    "server": "node server.js",
    "chat": "node client.js",
    "discover": "node discovery.js",
    "server:lan": "node -e \"process.env.HOST='0.0.0.0';require('./server')\"",
    "start": "node cli.js",
    "server:online": "node cli.js online",
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "termichat": "cli.js"
  },
  "files": [
    "cli.js",
    "client.js",
    "server.js",
    "discovery.js",
    "README.md",
    "invite.js",
    "share.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloverhimself/TermiChat.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
